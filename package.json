{
  "name": "compliance-authorizer",
  "version": "0.3.0.0",
  "description": "Runtime compliance authorization for agentic payments — signed allow/deny/review decisions with verifiable evidence envelopes. Ships an uncertified synthetic demo rule pack (Shariah profile v0.1): not a fatwa / not certified / not production advice.",
  "type": "module",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "node --experimental-strip-types --no-warnings src/index.ts",
    "start": "node dist/index.js",
    "verify": "node verifier/verify.mjs",
    "verify:fixture": "node verifier/verify.mjs --evidence examples/casino-hotel.evidence.jws --jwks examples/jwks.json --pack examples/pack.json",
    "replay": "node --experimental-strip-types --no-warnings scripts/replay.ts --evidence examples/casino-hotel.evidence.jws --pack examples/pack.json",
    "replay:verified": "node --experimental-strip-types --no-warnings scripts/replay.ts --evidence examples/casino-hotel.evidence.jws --pack examples/pack.json --jwks examples/jwks.json",
    "build:example": "node --experimental-strip-types --no-warnings scripts/build-example.ts"
  },
  "dependencies": {
    "@fastify/static": "^9.1.3",
    "@fastify/type-provider-typebox": "^6.1.0",
    "@sinclair/typebox": "^0.34.49",
    "fastify": "^5.8.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.9.3",
    "eslint": "^10.4.1",
    "fast-check": "^4.8.0",
    "happy-dom": "^20.10.2",
    "jose": "^6.2.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1",
    "vitest": "^4.1.8"
  }
}
